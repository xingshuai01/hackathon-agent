# ==========================================================
# 复制为 .env 后填写。.env 已被 .gitignore 排除,不要提交。
#   cp .env.example .env
# ==========================================================

# ---------- LLM API(必填)----------
# 具体 provider 在 D1 选题锁定后确认,以下三选一填写即可
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI 兼容(如走中转/其他供应商时填写)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- 运行控制(可选)----------
# 单次运行最大工具调用轮次,防止死循环
MAX_TURNS=20
# 单次运行的总 token 预算上限
MAX_TOTAL_TOKENS=200000
# 单次 API 请求超时(毫秒)
REQUEST_TIMEOUT_MS=120000

# ---------- 演示可靠性(建议演示时打开)----------
# replay = 回放 fixtures/ 里录制好的响应,不访问网络
# live   = 真实调用 API
DEMO_MODE=live
# fixtures 目录,DEMO_MODE=replay 时从这里读取
FIXTURES_DIR=./fixtures

# ---------- 日志与调试 ----------
# 每次运行的 JSONL trace 输出目录,便于复盘与回放
TRACE_DIR=./logs
LOG_LEVEL=info
