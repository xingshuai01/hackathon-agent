# ==========================================================
# 复制为 .env 后填写。.env 已被 .gitignore 排除,不要提交。
#   cp .env.example .env
#
# ⚠️ API Key 由每位成员填自己的(DEC-028),不要共享、不要提交。
# ==========================================================

# ---------- LLM:DeepSeek(必填)----------
# 申请地址:https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 接口地址(一般不用改)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 主模型:负责 Agent 主循环、方案生成、技能聚合
DEEPSEEK_MODEL=deepseek-v4-pro

# 便宜模型:负责 A 知识库相关性筛选、MethodSpec 抽取等"选/抽"类任务
# ⚠️ 必须带 -v4-:实测 `deepseek-flash` 会返回 400(模型名不存在),
#    正确值是 deepseek-v4-flash,与 src/services/llm/deepseek.ts 的默认值一致
DEEPSEEK_CHEAP_MODEL=deepseek-v4-flash

# 思考模式开关。Agent 主循环必须是 disabled(DEC-030):
#   思考模式下不支持 tool_choice: required / 指定具体工具,会返回 400
# 可选:disabled | enabled
DEEPSEEK_THINKING=disabled

# 思考强度(仅当 DEEPSEEK_THINKING=enabled 时生效):none | low | high | max
DEEPSEEK_REASONING_EFFORT=high

# ---------- SciencePal(DEC-032:作为主循环里的一个工具节点)----------
# 作用:注册 sciencepal_query 工具,让我们的 Agent 能调用 SciencePal 的科研智能体
#       (默认 Survey Agent 做系统性文献综述)。这是比赛「实质性使用」的落点。
# 申请:登录 sciencepal.ai → 用户菜单 → Connections & development → API & Python SDK
# ⚠️ 留空则不注册该工具,其余功能照常可用
SCIENCEPAL_API_KEY=
SCIENCEPAL_BASE_URL=https://sciencepal.ai/api

# 默认 Agent:Survey Agent(学术综述)。其他可选:
#   10000000-0000-0000-0000-000000000001  General Agent(通用科学工程)
#   10000000-0000-0000-0000-000000000002  Biology Agent
#   10000000-0000-0000-0000-000000000003  Material Agent
#   10000000-0000-0000-0000-00000000000a  MIMIC Agent(临床)
SCIENCEPAL_AGENT_ID=10000000-0000-0000-0000-000000000007

# 指定平台模型。留空则用平台默认;本项目实测均用 pro 档(flash 档见 platform::deepseek-v4-flash)
SCIENCEPAL_MODEL=platform::deepseek-v4-pro

# initiate 实测约 28 秒,超时给足
SCIENCEPAL_INITIATE_TIMEOUT_MS=120000
# 整个 SciencePal 运行的最长等待
SCIENCEPAL_RUN_TIMEOUT_MS=600000

# ---------- 运行控制(可选)----------
# 单次运行最大工具调用轮次,防死循环
MAX_TURNS=20
# 单次运行的总 token 预算上限(DeepSeek 便宜,可以放宽)
MAX_TOTAL_TOKENS=500000
# 单次 API 请求超时(毫秒)
REQUEST_TIMEOUT_MS=120000
# 重试次数(指数退避 + 抖动)
MAX_RETRIES=3
# 工具并发上限(源码默认 10,我们收到 3 以照顾现场网络)
MAX_CONCURRENCY=3

# ---------- 演示可靠性(建议演示时打开)----------
# replay = 从 fixtures/ 回放录制好的响应,零网络请求
# live   = 真实调用 DeepSeek API
DEMO_MODE=live
# fixtures 目录,DEMO_MODE=replay 时从这里读取
FIXTURES_DIR=./fixtures

# ---------- Web(DEC-003 / DEC-006)----------
# Web 服务起始端口;被占用时自动顺延(尝试 20 个)
WEB_PORT=7777
# 是否启动时自动打开浏览器
WEB_OPEN_BROWSER=true

# ---------- 日志与调试 ----------
# 每次运行的 JSONL trace 输出目录,便于复盘与回放
TRACE_DIR=./logs
# debug | info | warn | error
LOG_LEVEL=info
