{
  "name": "hackathon-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "科研领域 Agent:知识库 / 工具库 / 技能库三个创新模块",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
    "ask": "node src/main.ts ask",
    "doctor": "node src/main.ts tools doctor",
    "demo": "node src/main.ts ask \"帮我算一下 1234 乘 5678 等于多少\" --fake",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-test-isolation=none \"test/**/*.test.ts\"",
    "check:rules": "node scripts/check-rules.mjs",
    "verify": "npm run typecheck && npm run check:rules && npm test"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
