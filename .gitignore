# ---- 本地工具 / 凭证(绝不入库)----
.tools/
.env
.env.*
!.env.example
*.pem
*.key

# ---- Node / TypeScript ----
node_modules/
.pnpm-store/
dist/
build/
out/
.next/
coverage/
*.tsbuildinfo
.npm/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.env/
.pytest_cache/
.ruff_cache/
*.egg-info/

# ---- 数据 / 产物(体积大或可重建)----
# 只在仓库根目录忽略,避免误伤 src/data/、tools/data/ 这类源码目录
/data/*
# fixtures 是 demo 固定样例,必须入库才可复现(见 docs/PLAN.md D3)
!/data/fixtures/
!/data/README.md
/artifacts/
/logs/
*.log
*.sqlite
*.db

# ---- 本地工具缓存 ----
.workbuddy

# ---- 第三方参考源码(仅本机阅读,绝不入库)----
# Claude Code 源码:1900+ 文件 / 29MB,且非本项目所有,提交会污染仓库并带来许可风险
/claude-code-main/

# ---- 编辑器 / 系统 ----
.vscode/*
!.vscode/settings.json.example
.idea/
.cursor/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- 临时 ----
tmp/
.tmp/
scratch/
*.tmp

# 论文 PDF 不入库(版权+体积),用 fixtures/papers/*.json 里的 sha256 校验
fixtures/papers/*.pdf

# ---- 生成物提交策略(DEC-034)----
# 知识页是**派生数据**:一条 ingest 命令即可重建。
# 且 createdAt 是运行时刻 —— 两人各跑一次就产生大量无意义 diff。
# 体积:20 条知识页 ≈ 15KB,10 篇论文就 150KB。
# 固定样例请放 fixtures/knowledge/(必须入库,评审"打开就能看")
/knowledge/*/
!/knowledge/README.md

# 技能草案要入库 —— 它是**人工审核待办清单**,
# 是数据铁律 #4(技能未经审核不得 active)的证据链,体积只有几 KB。
# 已晋升的 skills/<id>/SKILL.md 同样是资产,一并入库。

